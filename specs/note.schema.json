{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Obsidian Agent Memory common frontmatter",
  "type": "object",
  "required": ["id", "type", "status", "created_at", "updated_at", "sources"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["source", "knowledge", "project", "decision", "session", "memory", "moc"]},
    "status": {"enum": ["draft", "active", "conflicted", "superseded", "archived"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"},
    "review_after": {"type": "string", "format": "date"},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scope": {"type": "string", "minLength": 1},
    "evidence": {"enum": ["explicit", "observed", "inferred", "unverified"]},
    "maintenance": {"enum": ["human", "shared", "agent", "generated"]},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["memory", "decision"]}}, "required": ["type"]},
      "then": {"required": ["scope", "evidence", "recorded_at"]}
    },
    {
      "if": {"properties": {"type": {"enum": ["memory", "decision"]}, "status": {"const": "active"}}, "required": ["type", "status"]},
      "then": {"properties": {"sources": {"minItems": 1}, "evidence": {"enum": ["explicit", "observed"]}}}
    }
  ],
  "additionalProperties": true
}
